{
	"schemaVersion": 1,
	"id": "template",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "${homepage_url}",
		"sources": "${source_url}",
		"issues": "${issue_url}"
	},
	"license": "${mod_license}",
	"icon": "assets/logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.invictusslayer.template.TemplateFabric"
		]
	},
	"mixins": [
		"template.mixins.json",
		"template-fabric.mixins.json"
	],
	"depends": {
		"java": ">=${java_version}",
		"minecraft": "~${mc_version}",
		"fabric": ">=${fabric_loader}",
		"fabric-api": "*"
	},
	"suggests": {
	}
}